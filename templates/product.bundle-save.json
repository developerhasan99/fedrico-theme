    "pm_bs_faq": {
      "type": "pm-bs-faq",
      "blocks": {
        "q_same": {
          "type": "question",
          "settings": {
            "question": "Do your fragrances smell the same as the designer inspiration?",
            "answer": "<p>Our fragrances are expertly crafted to capture the essence and character of popular designer scents. While we create inspired interpretations rather than exact copies, 98% of our customers say our fragrances are virtually identical to the original brands they love. Each fragrance is carefully developed to deliver the same luxurious experience at a fraction of the cost.</p>"
          }
        },
        "q_last": {
          "type": "question",
          "settings": {
            "question": "How long will the scent last?",
            "answer": "<p>It depends on the line. Classic: 15% perfume oil, about 5-8 hours. PURE: 20%, about 10-12 hours. PURE ROYAL: 24%, up to 16 hours. Longevity can vary based on skin type, application method, and individual body chemistry. For best results, apply to pulse points on clean, moisturized skin.</p>"
          }
        },
        "q_mix": {
          "type": "question",
          "settings": {
            "question": "Can I mix and match scents in a bundle?",
            "answer": "<p>Yes. Pick any scents you like, in any combination, and add the same scent more than once if you want. The price per bottle drops as you add more: 1 bottle $24, 2 bottles $38, 3 bottles $51, 4 bottles $60, and every bottle after that $15.</p>"
          }
        },
        "q_return": {
          "type": "question",
          "settings": {
            "question": "What if I pick a scent I don't love?",
            "answer": "<p>We offer a 60-day money-back guarantee. If you're not completely satisfied with your fragrance, simply return it within 60 days for a full refund. You can even test the fragrance once or twice before deciding. No questions asked, no hassle.</p>"
          }
        },
        "q_ship": {
          "type": "question",
          "settings": {
            "question": "How long does it take to process orders and ship?",
            "answer": "<p>Orders ship the next business day.</p>"
          }
        },
        "q_quality": {
          "type": "question",
          "settings": {
            "question": "How can I trust the quality at this price?",
            "answer": "<p>We cut out the middleman and brand markup, not the quality. Our fragrances are made without harsh chemicals, using high concentrations of premium fragrance oils, the same quality ingredients found in luxury brands. We're so confident in our products that we offer a 60-day money-back guarantee.</p>"
          }
        },
        "q_vegan": {
          "type": "question",
          "settings": {
            "question": "Are your products vegan friendly and cruelty free?",
            "answer": "<p>We only use <strong>vegan-friendly</strong> fragrance oils, and of course they are <strong>cruelty-free</strong>. We wouldn't have it any other way.</p>"
          }
        },
        "q_skin": {
          "type": "question",
          "settings": {
            "question": "Are your fragrances safe for sensitive skin?",
            "answer": "<p>Our fragrances are formulated to high safety standards, but like all fragrances, they may contain allergens. We recommend patch testing before full use, especially if you have sensitive skin. All ingredients comply with international safety regulations for cosmetic products.</p>"
          }
        }
      },
