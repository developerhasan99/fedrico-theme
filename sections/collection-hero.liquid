{{ 'pm-s-collection-hero.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign layout = section.settings.layout | default: 'image'
  assign hero_mobile_image = collection.metafields.custom.hero_mobile_image
  assign hero_desktop_image = collection.image
  assign show_description = section.settings.show_description
  if collection.description == blank
    assign show_description = false
  endif
  assign more_label = section.settings.description_more_label | default: '+ Read more'
  assign less_label = section.settings.description_less_label | default: '− Read less'
-%}

{%- capture rating_badge -%}
  {%- if section.settings.show_rating_badge -%}
    <p class="pm-chero__rating pm-eyebrow">
      {%- render 'pm-stars', rating: 5, size: 12, class: 'pm-chero__stars' -%}
      <span>{{ section.settings.rating_text }}</span>
    </p>
  {%- endif -%}
{%- endcapture -%}

{%- if layout == 'compact' -%}
  <div class="pm-chero pm-chero--compact page-width">
    {%- if section.settings.show_breadcrumbs -%}
      <nav class="pm-chero__crumbs">
        {%- if section.settings.breadcrumb_home_label != blank -%}
          <a href="{{ routes.root_url }}">{{ section.settings.breadcrumb_home_label }}</a>
          {%- render 'pm-icon', icon: 'chevron-right', size: 12 -%}
        {%- endif -%}
        <span aria-current="page">{{ collection.title }}</span>
      </nav>
    {%- endif -%}
    {{ rating_badge }}
    <h1 class="pm-chero__title pm-title">{{ collection.title }}</h1>
    {%- if show_description -%}
      {%- comment -%}
        Folded to the first two sentences (magyx.co pattern): the script right after this block runs while the page
        is parsed, before the first paint, so the full text never flashes up. Without JavaScript the whole
        description shows and the toggle stays hidden.
      {%- endcomment -%}
      <div class="pm-chero__desc pm-cdesc" data-pm-cdesc>
        <div class="pm-cdesc__text" id="PmCollectionDescription-{{ section.id }}">{{ collection.description }}</div>
        <button
          type="button"
          class="pm-cdesc__toggle"
          aria-expanded="false"
          aria-controls="PmCollectionDescription-{{ section.id }}"
          data-more="{{ more_label | escape }}"
          data-less="{{ less_label | escape }}"
          hidden
        >
          {{- more_label | escape -}}
        </button>
      </div>
      <script>
        (function () {
          // Shows the first two sentences of the description; the rest (the remainder of that paragraph and every
          // block after it) gets [hidden] until the toggle opens it. A sentence ends at . ! or ? followed by a space
          // and a capital, a quote, a bracket or a digit, or at the end of a paragraph; "No." before a number is not
          // an end.
          var SHOWN = 2;
          var setup = function (root) {
            if (!root || !root.hasAttribute('data-pm-cdesc') || root.dataset.pmReady) return;
            root.dataset.pmReady = '1';
            var text = root.querySelector('.pm-cdesc__text');
            var toggle = root.querySelector('.pm-cdesc__toggle');
            if (!text || !toggle) return;
            var blocks = [];
            var loose = false;
            for (var n = text.firstChild; n; n = n.nextSibling) {
              if (n.nodeType === 1) blocks.push(n);
              else if (n.nodeType === 3 && n.nodeValue.trim()) loose = true;
            }
            if (loose || !blocks.length) blocks = [text];
            var ends = function (str) {
              var out = [];
              var re = /[.!?]+["'”’)]*(?=\s+["'“‘„(]?[A-Z0-9À-Ž])/g;
              var m;
              while ((m = re.exec(str))) {
                if (/\bno\.$/i.test(str.slice(0, m.index + 1)) && /^\s+\d/.test(str.slice(re.lastIndex))) continue;
                out.push(re.lastIndex);
              }
              var trimmed = str.replace(/\s+$/, '');
              if (/[.!?]["'”’)]*$/.test(trimmed) && out[out.length - 1] !== trimmed.length) out.push(trimmed.length);
              return out;
            };
            var count = 0;
            var cutBlock = -1;
            var cutAt = -1;
            for (var i = 0; i < blocks.length && cutBlock < 0; i++) {
              var e = ends(blocks[i].textContent);
              if (count + e.length >= SHOWN) {
                cutBlock = i;
                cutAt = e[SHOWN - count - 1];
              }
              count += e.length;
            }
            if (cutBlock < 0) return;
            var hide = [];
            var block = blocks[cutBlock];
            var rest = block.textContent.slice(cutAt);
            if (rest.trim()) {
              // The second sentence ends inside a paragraph: move the rest of that paragraph into a hidden span.
              var walker = document.createTreeWalker(block, NodeFilter.SHOW_TEXT);
              var seen = 0;
              var node;
              while ((node = walker.nextNode())) {
                if (seen + node.nodeValue.length >= cutAt) break;
                seen += node.nodeValue.length;
              }
              if (!node) return;
              var range = document.createRange();
              range.setStart(node, cutAt - seen);
              range.setEnd(block, block.childNodes.length);
              var span = document.createElement('span');
              span.className = 'pm-cdesc__rest';
              span.appendChild(range.extractContents());
              block.appendChild(span);
              hide.push(span);
            }
            for (var j = cutBlock + 1; j < blocks.length; j++) {
              if (blocks[j] !== text && blocks[j].textContent.trim()) hide.push(blocks[j]);
            }
            if (!hide.length) return;
            if (block !== text) block.classList.add('pm-cdesc__cut');
            hide.forEach(function (el) {
              el.hidden = true;
            });
            toggle.hidden = false;
            toggle.addEventListener('click', function () {
              var open = toggle.getAttribute('aria-expanded') !== 'true';
              toggle.setAttribute('aria-expanded', String(open));
              toggle.textContent = open ? toggle.dataset.less : toggle.dataset.more;
              root.classList.toggle('is-open', open);
              hide.forEach(function (el) {
                el.hidden = !open;
              });
            });
          };
          var scripts = document.getElementsByTagName('script');
          var me = document.currentScript || scripts[scripts.length - 1];
          setup(me && me.previousElementSibling);
          if (!window.pmCdescEditor) {
            window.pmCdescEditor = true;
            document.addEventListener('shopify:section:load', function (event) {
              event.target.querySelectorAll('[data-pm-cdesc]').forEach(setup);
            });
          }
        })();
      </script>
    {%- endif -%}
  </div>
{%- else -%}
  {%- style -%}
    .pm-chero-{{ section.id }} {
      {% if hero_mobile_image %}--hero-img-mobile: url('{{ hero_mobile_image | image_url: width: 750 }}');{% endif %}
      {% if hero_desktop_image %}--hero-img-desktop: url('{{ hero_desktop_image | image_url: width: 1920 }}');{% endif %}
    }
  {%- endstyle -%}
  <div class="pm-chero pm-chero--image pm-chero-{{ section.id }} relative flex h-auto min-h-[520px] items-end bg-[image:var(--hero-img-mobile)] bg-cover bg-[position:50%_10%] bg-no-repeat pb-[34px] sm:h-[clamp(430px,33.33vw,600px)] sm:min-h-0 sm:items-center sm:bg-[image:var(--hero-img-desktop)] sm:bg-[position:50%_3%] sm:pb-0">
    <div class="pm-chero__scrim" aria-hidden="true"></div>
    <div class="page-width relative z-[1] w-full">
      {{ rating_badge }}
      <h1 class="pm-chero__title">{{ collection.title }}</h1>
      {%- if show_description -%}
        <div class="pm-chero__desc"><div class="pm-chero__text">{{ collection.description }}</div></div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
  {
    "name": "Collection Hero",
    "settings": [
      {
        "type": "select",
        "id": "layout",
        "label": "Layout",
        "options": [
          {
            "value": "image",
            "label": "Image (full-bleed collection image)"
          },
          {
            "value": "compact",
            "label": "Compact (breadcrumb, title, description)"
          }
        ],
        "default": "image"
      },
      {
        "type": "checkbox",
        "id": "show_breadcrumbs",
        "label": "Show breadcrumbs (compact layout)",
        "default": true
      },
      {
        "type": "text",
        "id": "breadcrumb_home_label",
        "label": "Breadcrumb home label",
        "default": "Home"
      },
      {
        "type": "checkbox",
        "id": "show_description",
        "label": "Show collection description",
        "default": true
      },
      {
        "type": "text",
        "id": "description_more_label",
        "label": "Description: show more",
        "default": "+ Read more",
        "info": "Compact layout: the description shows its first two sentences; this opens the rest"
      },
      {
        "type": "text",
        "id": "description_less_label",
        "label": "Description: show less",
        "default": "− Read less"
      },
      {
        "type": "checkbox",
        "id": "show_rating_badge",
        "label": "Show rating badge",
        "default": true
      },
      {
        "type": "text",
        "id": "rating_text",
        "label": "Rating badge text",
        "default": "Verified by over 10,000 fragrance lovers"
      }
    ],
    "presets": [
      {
        "name": "Collection Hero"
      }
    ]
  }
{% endschema %}
