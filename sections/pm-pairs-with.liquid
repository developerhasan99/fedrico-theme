{%- comment -%}
  "Pairs well with" rail for the product page (product.quantity-breakers: between the buy box and the marquee).

  Products: Shopify product recommendations for the product on screen, fetched after load through the
  recommendations endpoint (this same section, rendered with recommendations.performed? true). Complementary
  products come first (Search & Discovery app > Complementary products; none are set today), then the automatic
  related products. If both come back empty, the fallback collection fills the rail (minus the product on screen);
  with nothing at all the section stays hidden.

  Cards = snippets/product-card.liquid with atc: the image and title open the product page, the button under the
  price adds the bottle through product-form (assets/product-form.js, loaded by the buy box) and opens the cart drawer.
  Styles: assets/pm-s-pairs.css. Swiper 11 is loaded sitewide from layout/theme.liquid.
{%- endcomment -%}
{%- liquid
  assign pairs_limit = section.settings.products_count | default: 8
-%}

{%- if recommendations.performed? -%}
  <div class="pm-pairs__result" data-count="{{ recommendations.products_count }}">
    {%- comment -%} Up to 10 (the endpoint's maximum): the script drops twins of the product on screen and repeats, then keeps "Products shown" {%- endcomment -%}
    {%- for pair in recommendations.products -%}
      <div class="swiper-slide pm-pairs__slide">
        {%- render 'product-card', product: pair, lazy: true, atc: true, section_id: section.id -%}
      </div>
    {%- endfor -%}
  </div>
{%- elsif product != blank -%}
  {{ 'pm-s-pairs.css' | asset_url | stylesheet_tag }}
  {%- style -%}
    .premium .pm-pairs--{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .premium .pm-pairs--{{ section.id }} {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <pm-pairs
    class="pm-pairs pm-pairs--{{ section.id }} color-{{ section.settings.color_scheme }} gradient"
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=10"
    data-max="{{ pairs_limit }}"
    data-title="{{ product.title | escape }}"
    {% unless request.design_mode %}hidden{% endunless %}>
    <div class="page-width">
      <div class="pm-pairs__head">
        <h2 class="pm-h2 pm-pairs__heading">{{ section.settings.heading | escape }}</h2>
        <div class="pm-pairs__nav">
          <button type="button" class="pm-pairs__arrow pm-pairs__arrow--prev" aria-label="{{ 'premium.general.previous' | t | escape }}">
            {%- render 'pm-icon', icon: 'arrow-right', size: 16 -%}
          </button>
          <button type="button" class="pm-pairs__arrow pm-pairs__arrow--next" aria-label="{{ 'premium.general.next' | t | escape }}">
            {%- render 'pm-icon', icon: 'arrow-right', size: 16 -%}
          </button>
        </div>
      </div>
      <div class="swiper pm-pairs__swiper">
        <div class="swiper-wrapper"></div>
      </div>
    </div>

    {%- comment -%} Used only when Shopify returns no recommendations {%- endcomment -%}
    <template class="pm-pairs__fallback">
      {%- assign pairs_shown = 0 -%}
      {%- for pair in section.settings.fallback_collection.products limit: 20 -%}
        {%- if pair.id == product.id or pair.title == product.title or pairs_shown >= pairs_limit -%}{%- continue -%}{%- endif -%}
        {%- assign pairs_shown = pairs_shown | plus: 1 -%}
        <div class="swiper-slide pm-pairs__slide">
          {%- render 'product-card', product: pair, lazy: true, atc: true, section_id: section.id -%}
        </div>
      {%- endfor -%}
    </template>
  </pm-pairs>

  <script>
    (function () {
      if (customElements.get('pm-pairs')) return;

      function slidesFrom(html) {
        var doc = new DOMParser().parseFromString(html, 'text/html');
        return Array.prototype.slice.call(doc.querySelectorAll('.pm-pairs__result .pm-pairs__slide'));
      }

      customElements.define('pm-pairs', class extends HTMLElement {
        connectedCallback() {
          if (this.started) return;
          this.started = true;
          var self = this;
          var url = this.dataset.url;
          function load(intent) {
            return fetch(url + '&intent=' + intent)
              .then(function (r) { return r.ok ? r.text() : ''; })
              .then(slidesFrom)
              .catch(function () { return []; });
          }
          Promise.all([load('complementary'), load('related')]).then(function (lists) {
            var slides = lists[0].length ? lists[0] : lists[1];
            if (!slides.length) {
              var tpl = self.querySelector('template.pm-pairs__fallback');
              if (tpl) slides = Array.prototype.slice.call(tpl.content.querySelectorAll('.pm-pairs__slide'));
            }
            slides = self.unique(slides);
            if (!slides.length) return;
            var wrap = self.querySelector('.swiper-wrapper');
            slides.forEach(function (s) { wrap.appendChild(document.importNode(s, true)); });
            self.hidden = false;
            self.startSwiper(0);
          });
        }

        // Some scents exist as two products with the same name (one per line). Skip the twin of the product on
        // screen and show every name once, then cut to "Products shown".
        unique(slides) {
          var key = function (t) { return (t || '').replace(/\s+/g, ' ').trim().toLowerCase(); };
          var seen = {};
          seen[key(this.dataset.title)] = true;
          var max = parseInt(this.dataset.max, 10) || 8;
          return slides.filter(function (s) {
            var t = s.querySelector('.pm-card__title');
            var k = key(t && t.textContent);
            if (!k || seen[k]) return false;
            seen[k] = true;
            return true;
          }).slice(0, max);
        }

        startSwiper(tries) {
          var self = this;
          if (typeof Swiper === 'undefined') {
            if (tries < 40) setTimeout(function () { self.startSwiper(tries + 1); }, 150);
            return;
          }
          // Under 750 the rail runs to the screen edges (assets/pm-s-pairs.css) and the page gutter becomes the
          // offset before the first card and after the last, so the first card lines up with the heading.
          var gutter = parseFloat(getComputedStyle(this.querySelector('.page-width')).paddingLeft) || 16;
          this.swiper = new Swiper(this.querySelector('.pm-pairs__swiper'), {
            slidesPerView: 2.2,
            spaceBetween: 12,
            slidesOffsetBefore: gutter,
            slidesOffsetAfter: gutter,
            watchOverflow: true,
            navigation: {
              prevEl: this.querySelector('.pm-pairs__arrow--prev'),
              nextEl: this.querySelector('.pm-pairs__arrow--next')
            },
            breakpoints: {
              750: { slidesPerView: 3.2, spaceBetween: 16, slidesOffsetBefore: 0, slidesOffsetAfter: 0 },
              990: { slidesPerView: 4, spaceBetween: 20, slidesOffsetBefore: 0, slidesOffsetAfter: 0 }
            }
          });
        }
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Pairs well with",
  "class": "section-pm-pairs",
  "settings": [
    {
      "type": "paragraph",
      "content": "Product page only. Shows Shopify's recommendations for the product on screen: complementary products set in the Search & Discovery app first, otherwise the automatic related products. Each card opens the product and has an Add to cart button."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pairs well with"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Products shown",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 8
    },
    {
      "type": "collection",
      "id": "fallback_collection",
      "label": "Fallback collection",
      "info": "Used when Shopify has no recommendations for the product."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  },
  "presets": [
    {
      "name": "Pairs well with"
    }
  ]
}
{% endschema %}
