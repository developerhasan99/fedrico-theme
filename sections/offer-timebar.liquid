{%- liquid
  comment
    style = classic keeps the flipdown bar exactly as before; style = minimal (set in header-group.json)
    renders one 36px scheme-coloured line with a plain-text countdown and loads neither flipdown file.
  endcomment
  assign pm_minimal = false
  if section.settings.style == 'minimal'
    assign pm_minimal = true
  endif
  comment
    Countdown switch ("Show countdown"): off = no clock, no "Ends in", no flipdown files, no timer script.
  endcomment
  assign tb_countdown = section.settings.show_countdown
  comment
    Goal line (snippets/tb-goal-line.liquid, "Goal line" settings): next goal in words + one marker per goal
    (discount steps, gift app's goals). Under the bar in both styles, not on the Bundle & Save pages (tb_bs).
  endcomment
  assign tb_bs = false
  if product.template_suffix == 'payday-60' or product.template_suffix == 'bundle-save' or collection.template_suffix == 'bundle-save'
    assign tb_bs = true
  endif
-%}
{%- if pm_minimal -%}
  {{ 'pm-s-offer-timebar.css' | asset_url | stylesheet_tag }}
{%- else -%}
{%- if tb_countdown -%}
<link rel="stylesheet" href="https://pbutcher.uk/flipdown/css/flipdown/flipdown.css">
<script defer src="https://pbutcher.uk/flipdown/js/flipdown/flipdown.js"></script>
{%- endif -%}

<style>
  /* FlipDown Custom Styles */
  .flipdown {
    width: 190px;
    height: 42px;
  }

  .flipdown div:empty {
    display: block;
  }

  .flipdown .rotor {
    font-size: 1.32rem;
    margin-right: 1.8px;
  }

  .flipdown .rotor,
  .flipdown .rotor-leaf,
  .flipdown .rotor-leaf-front,
  .flipdown .rotor-leaf-rear,
  .flipdown .rotor-top,
  .flipdown .rotor-bottom,
  .flipdown .rotor:after {
    width: 18px;
  }

  .flipdown .rotor-group {
    padding-right: 12px;
  }

  .flipdown .rotor-group:last-child {
    padding-right: 0;
  }

  .flipdown .rotor-group-heading:before {
    font-size: 0.48rem;
    height: 12px;
    line-height: 12px;
  }

  .flipdown .rotor-group:nth-child(n + 2):nth-child(-n + 3):before,
  .flipdown .rotor-group:nth-child(n + 2):nth-child(-n + 3):after {
    left: 41px;
  }

  .flipdown .rotor-group:nth-child(n + 2):nth-child(-n + 3):before {
    bottom: 7.8px;
    height: 4.8px;
    width: 4.8px;
  }

  .flipdown .rotor-group:nth-child(n + 2):nth-child(-n + 3):after {
    bottom: 17.4px;
    height: 4.8px;
    width: 4.8px;
  }

  .flipdown .rotor-leaf-front,
  .flipdown .rotor-top {
    line-height: 30px;
  }

  .flipdown .rotor-leaf,
  .flipdown .rotor {
    height: 30px;
  }

  .flipdown .rotor-leaf-front,
  .flipdown .rotor-leaf-rear,
  .flipdown .rotor-top,
  .flipdown .rotor-bottom,
  .flipdown .rotor:after {
    height: 15px;
  }

  .flipdown.flipdown__theme-dark .rotor-group-heading:before {
    color: {{ section.settings.primary_color }};
    font-size: 8px;
    font-weight: 400;
    text-transform: uppercase;
  }

  /* Timebar Section Styles */
  .timebar-section-bg {
    display: block;
    text-decoration: none;
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: #f87171;
    background-repeat: repeat;
  }

  .timebar-container {
    max-width: 1280px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 16px;
    padding-right: 16px;
  }

  .timebar-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .timebar-sale-text {
    color: white;
    font-size: 2rem;
    line-height: 1;
  }

  @media (min-width: 768px) {
    .timebar-row {
      gap: 16px;
    }
  }

  /* Coupon Button Styles */
  .flipdown.flipdown__theme-dark .rotor-bottom,
  .flipdown.flipdown__theme-dark .rotor-leaf-rear,
  .flipdown.flipdown__theme-dark .rotor,
  .flipdown.flipdown__theme-dark .rotor-top,
  .flipdown.flipdown__theme-dark .rotor-leaf-front,
  .flipdown.flipdown__theme-dark .rotor-group:nth-child(n + 2):nth-child(-n + 3):before,
  .flipdown.flipdown__theme-dark .rotor-group:nth-child(n + 2):nth-child(-n + 3):after {
    background-color: {{ section.settings.primary_color }};
  }

  .flipdown.flipdown__theme-dark .rotor:after {
    border-color: {{ section.settings.primary_color }};
  }

  {% if section.settings.countdown_date == blank %}
    .flipdown {
      width: 140px !important;
    }
    .flipdown .rotor-group:first-child {
      display: none;
    }
  {% endif %}
</style>
{%- endif -%}

{% unless product.template_suffix == 'payday-60' or product.template_suffix == 'bundle-save' or collection.template_suffix == 'bundle-save' %}
  {%- if pm_minimal -%}
  <div id="{{ section.id }}" class="pm-timebar color-{{ section.settings.color_scheme }}">
    <a href="{{ section.settings.link }}" class="pm-timebar__link">
      {% comment %} {% render 'fuel01-announcement'
                    , section: section %} {% endcomment %}
      <span class="pm-timebar__text">{{ section.settings.prepend_text }}</span>
      {%- if tb_countdown -%}
        <span class="pm-timebar__sep" aria-hidden="true">&middot;</span>
        <span class="pm-timebar__ends">{{ 'premium.announcement.ends_in' | t }} <span class="pm-timebar__clock" data-pm-countdown>00:00:00</span></span>
      {%- endif -%}
      {%- if section.settings.append_text != blank -%}
        <span class="pm-timebar__sep pm-timebar__sep--cta" aria-hidden="true">&middot;</span>
        <span class="pm-timebar__cta">{{ section.settings.append_text }}{% render 'pm-icon', icon: 'arrow-right', size: 12, stroke: 1.75, class: 'pm-timebar__arrow' %}</span>
      {%- endif -%}
    </a>
    {%- unless tb_bs -%}<div class="tb-goal-slot">{% render 'tb-goal-line', section: section %}</div>{%- endunless -%}
  </div>
  {%- else -%}
  <div id="{{ section.id }}">
    <a href="{{ section.settings.link }}" class="no-underline block">
      {% if section.settings.top_banner_text != blank %}
        <div class="py-3" style="background-color: {{ section.settings.primary_color }};">
          <div class="page-width">
            <div class="text-center text-white flex items-center justify-center gap-4 leading-none">-
              <span>{{ section.settings.top_banner_text }}</span>
              -</div>
          </div>
        </div>
      {% endif %}
      {% comment %} {% render 'fuel01-announcement'
                    , section: section %} {% endcomment %}
      <div class="py-3 md:py-2" style="background-color: {{ section.settings.secondary_color }};">
        <div class="container mx-auto px-4">
          <div class="flex flex-wrap items-center gap-x-6 gap-y-1 justify-center">
            <div class="flex flex-wrap gap-x-4 gap-y-1 items-center justify-center">
              <div style="color: {{ section.settings.primary_color }};" class="font-bold text-base md:text-xl">
                {{ section.settings.prepend_text }}
              </div>
              <div style="color: {{ section.settings.primary_color }};" class="font-semibold text-sm md:text-lg tracking-wider md:order-1 underline">
                {{ section.settings.append_text }}
              </div>
              {%- if tb_countdown -%}
              <div class="flex items-center gap-2">
                <div style="color: {{ section.settings.primary_color }};" class="text-sm md:text-base font-bold leading-none md:hidden">
                  Ends in
                </div>
                <div id="flipdown" class="flipdown"></div>
              </div>
              {%- endif -%}
            </div>
            {% if section.blocks.size > 0 %}
              <div class="[display:none] md:flex gap-4">
                {% for block in section.blocks %}
                  <div class="flex flex-col items-center {% unless forloop.last %}pr-4 border-0 border-r border-solid border-gray-300{% endunless %}">
                    <img
                      class="rounded"
                      src="{{ block.settings.icon |  image_url  }}"
                      height="25"
                      width=""
                      alt="{{ block.settings.label }}">
                    <div class="leading-none text-xs mt-1 font-semibold text-black">
                      {{ block.settings.label }}
                    </div>
                  </div>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </a>
    {%- unless tb_bs -%}<div class="tb-goal-slot" style="background-color: {{ section.settings.secondary_color }};">{% render 'tb-goal-line', section: section %}</div>{%- endunless -%}
  </div>
  {%- endif -%}
{% endunless %}
{% if section.blocks.size > 0 and pm_minimal == false %}
  <div class="md:hidden py-3 border-0 border-b border-solid border-gray-200">
    <div class="page-width">
      <div class="flex gap-2 justify-between">
        {% for block in section.blocks %}
          <div class="flex flex-col items-center">
            <img
              class="rounded"
              src="{{ block.settings.icon |  image_url  }}"
              height="25"
              width=""
              alt="{{ block.settings.label }}">
            <div class="leading-none text-xs mt-1 font-semibold text-black">
              {{ block.settings.label }}
            </div>
          </div>
          {% unless forloop.last %}
            <div class="!block w-[1px] bg-gray-200 self-stretch"></div>
          {% endunless %}
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}

{%- if tb_countdown -%}
{%- if pm_minimal -%}
<script>
  (function () {
    var root = document.getElementById({{ section.id | json }});
    var clock = root ? root.querySelector('[data-pm-countdown]') : null;
    if (!clock) return;
    var configured = {{ section.settings.countdown_date | json }};
    function nextMidnight() { var d = new Date(); d.setHours(24, 0, 0, 0); return d.getTime(); }
    var deadline = configured ? new Date(configured).getTime() : NaN;
    if (isNaN(deadline)) { configured = null; deadline = nextMidnight(); }
    function pad(n) { return (n < 10 ? '0' : '') + n; }
    function tick() {
      var left = Math.max(0, Math.floor((deadline - Date.now()) / 1000));
      if (left === 0 && !configured) { deadline = nextMidnight(); left = Math.floor((deadline - Date.now()) / 1000); }
      clock.textContent = pad(Math.floor(left / 3600)) + ':' + pad(Math.floor((left % 3600) / 60)) + ':' + pad(left % 60);
    }
    tick();
    var timer = setInterval(function () {
      if (!clock.isConnected) { clearInterval(timer); return; }
      tick();
    }, 1000);
  })();
</script>
{%- else -%}
<script>
  (function () {
  function initFlipdown() {
    function getNextMidnightTimestamp() {
      const nextMidnight = new Date();

      nextMidnight.setHours(24, 0, 0, 0); // next day 00:00:00

      return Math.floor(nextMidnight.getTime() / 1000);
    }

    function getCountdownDeadline() {
      const configuredDate = {{ section.settings.countdown_date | json }};

      if (!configuredDate) {
        return getNextMidnightTimestamp();
      }

      const configuredTimestamp = Math.floor(new Date(configuredDate).getTime() / 1000);

      return Number.isNaN(configuredTimestamp) ? getNextMidnightTimestamp() : configuredTimestamp;
    }

    const deadline = getCountdownDeadline();

    // Countdown headings per Weglot language (falls back to "en")
    const countdownHeadings = {
      en: ["Days", "Hours", "Min", "Sec"],
      sv: ["Dag", "Tim", "Min", "Sek"],
      da: ["Dag", "Timer", "Min", "Sek"],
      fi: ["Päivä", "Tunti", "Min", "Sek"],
      no: ["Dag", "Time", "Min", "Sek"],
    };

    const flipdownEl = document.getElementById('flipdown');

    function buildFlipdown(lang) {
      const headings = countdownHeadings[lang] || countdownHeadings.en;

      // Clear any previously rendered rotors before re-instantiating
      if (flipdownEl) {
        flipdownEl.innerHTML = '';
      }

      new FlipDown(deadline, {
        headings: headings,
      })
        .start()
        .ifEnded(() => {
          console.log('Countdown ended');
        });
    }

    const currentLang = (window.Weglot && typeof Weglot.getCurrentLang === 'function' && Weglot.getCurrentLang()) || 'en';
    buildFlipdown(currentLang);

    if (window.Weglot && typeof Weglot.on === 'function') {
      Weglot.on('languageChanged', function (newLang) {
        buildFlipdown(newLang);
      });
    }
  }

  // Works on first load and when the theme editor re-renders the section (switch turned back on):
  // waits for the deferred flipdown.js instead of relying on DOMContentLoaded.
  function whenFlipdownReady() {
    if (!document.getElementById('flipdown')) return;
    if (typeof FlipDown === 'function') { initFlipdown(); return; }
    var tries = 0;
    var wait = setInterval(function () {
      if (typeof FlipDown === 'function') { clearInterval(wait); initFlipdown(); }
      else if (++tries > 100) { clearInterval(wait); }
    }, 100);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', whenFlipdownReady);
  } else {
    whenFlipdownReady();
  }
  })();
</script>
{%- endif -%}
{%- endif -%}

{% schema %}
  {
    "name": "Offer Timebar",
    "settings": [
      {
        "type": "select",
        "id": "style",
        "label": "Style",
        "options": [
          {
            "value": "classic",
            "label": "Classic (flip countdown, icons)"
          },
          {
            "value": "minimal",
            "label": "Minimal (one line, plain countdown)"
          }
        ],
        "default": "classic",
        "info": "Minimal uses the colour scheme below and ignores the colours and icon blocks."
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "t:sections.all.colors.label",
        "default": "scheme-4",
        "info": "Minimal style only."
      },
      {
        "type": "color",
        "id": "primary_color",
        "label": "Primary Color",
        "default": "#173E34"
      },
      {
        "type": "color",
        "id": "secondary_color",
        "label": "Secondary Color",
        "default": "#DCE9DE"
      },
      {
        "type": "text",
        "id": "top_banner_text",
        "label": "Top Banner Text",
        "info": "Leaving this field will disable the banner."
      },
      {
        "type": "text",
        "id": "prepend_text",
        "label": "Prepend Text",
        "default": "Exclusive Offer"
      },
      {
        "type": "checkbox",
        "id": "show_countdown",
        "label": "Show countdown",
        "default": true,
        "info": "Off hides the timer and the \"Ends in\" text. The rest of the bar stays."
      },
      {
        "type": "text",
        "id": "countdown_date",
        "label": "End Date and Time",
        "info": "Format: YYYY/MM/DD HH:MM:SS (e.g., 2026/12/25 23:59:59)"
      },
      {
        "type": "text",
        "id": "append_text",
        "label": "Append Text",
        "default": "Shop Now"
      },
      {
        "type": "url",
        "id": "link",
        "label": "Link"
      },
      {
        "type": "header",
        "content": "Goal line"
      },
      {
        "type": "paragraph",
        "content": "One sentence about the next discount step above a track with one marker per goal: the discount steps below plus the gift app's goals (free gifts, free shipping; marker only, never in the sentence). Display only: the discount comes from the discount codes, the gifts from the gift app."
      },
      {
        "type": "checkbox",
        "id": "goal_line_enable",
        "label": "Show the goal line",
        "default": true
      },
      {
        "type": "text",
        "id": "goal_line_markets",
        "label": "Markets",
        "info": "Market handles, comma separated. Empty = every market."
      },
      {
        "type": "text",
        "id": "goal_line_lang",
        "label": "Language of the texts",
        "info": "Weglot language code (e.g. en). The line stays off pages Weglot translated into another language. Empty = no check."
      },
      {
        "type": "text",
        "id": "goal_steps",
        "label": "Discount steps",
        "info": "bottles:percent, comma separated. Must match the discount codes. Every bottle size counts as 1.",
        "default": "2:25, 4:30, 6:35, 8:40"
      },
      {
        "type": "text",
        "id": "goal_bs_handle",
        "label": "Choose & Save product handle",
        "info": "Its price per bottle places the gift app's markers on the track.",
        "default": "bundle-and-save"
      },
      {
        "type": "text",
        "id": "goal_text_empty",
        "label": "Text, empty cart",
        "info": "[n] = bottles of the first step, [pct] = its discount",
        "default": "Add [n] and get [pct] OFF"
      },
      {
        "type": "text",
        "id": "goal_text_step",
        "label": "Text, next discount step",
        "info": "[n] = bottles still needed, [pct] = that step's discount",
        "default": "Add [n] more and get [pct] OFF"
      },
      {
        "type": "text",
        "id": "goal_text_unlocked",
        "label": "Text, step reached",
        "info": "Shown for 3 seconds after the cart reaches a discount step. [rewards] = the label below",
        "default": "[rewards] unlocked"
      },
      {
        "type": "text",
        "id": "goal_text_done",
        "label": "Text, every step reached",
        "info": "[pct] = the top discount",
        "default": "You get [pct] OFF"
      },
      {
        "type": "text",
        "id": "goal_label_pct",
        "label": "Label, discount",
        "default": "[pct] OFF"
      },
      {
        "type": "text",
        "id": "goal_word_one",
        "label": "Word, 1 bottle",
        "default": "bottle"
      },
      {
        "type": "text",
        "id": "goal_word_many",
        "label": "Word, bottles",
        "default": "bottles"
      }
    ],
    "blocks": [
      {
        "type": "payment_icon",
        "name": "Payment Icon",
        "settings": [
          {
            "type": "image_picker",
            "id": "icon",
            "label": "Icon"
          },
          {
            "type": "text",
            "id": "label",
            "label": "Label"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Offer Timebar"
      }
    ]
  }
{% endschema %}