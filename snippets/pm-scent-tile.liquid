{%- comment -%}
  One scent-notes tile (pdp-scent-notes).
  Accepts:
  - label: layer label, e.g. Top notes
  - name: ingredient shown on the tile
  - image: image or media_image object (optional; renders the photo tile)
{%- endcomment -%}
<li class="pm-scent__tile{% if image != blank %} pm-scent__tile--image{% endif %}">
  {%- if image != blank -%}
    {{ image | image_url: width: 1200 | image_tag: widths: '400, 600, 800, 1200', sizes: '(min-width: 1216px) 384px, (min-width: 750px) 32vw, 100vw', loading: 'lazy', alt: '', class: 'pm-scent__img' }}
  {%- endif -%}
  <p class="pm-scent__label">{{ label }}</p>
  <p class="pm-scent__name">{{ name }}</p>
</li>
